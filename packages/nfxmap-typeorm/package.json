{
  "name": "nfxmap-typeorm",
  "version": "0.1.0",
  "description": "TypeORM data provider for nfxmap (FxMap for Node.js): answers the requests for an entity from a SQL database",
  "license": "Apache-2.0",
  "author": "quyvu01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quyvu01/nfxmap.git",
    "directory": "packages/nfxmap-typeorm"
  },
  "keywords": [
    "fxmap",
    "nfxmap",
    "typeorm",
    "sql",
    "postgres",
    "mysql",
    "sqlite",
    "mapping",
    "distributed"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "nfxmap": "^0.1.0",
    "typeorm": "^0.3.20 || ^1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^12.11.1",
    "nfxmap": "*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
