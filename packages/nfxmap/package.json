{
  "name": "nfxmap",
  "version": "0.1.0",
  "description": "FxMap for Node.js: declare where a property comes from, and nfxmap fetches it from the service that owns the data",
  "license": "Apache-2.0",
  "author": "quyvu01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quyvu01/nfxmap.git",
    "directory": "packages/nfxmap"
  },
  "keywords": ["fxmap", "mapping", "distributed", "microservices", "dto", "enrichment"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./expressions": {
      "import": {
        "types": "./dist/esm/expressions/index.d.ts",
        "default": "./dist/esm/expressions/index.js"
      },
      "require": {
        "types": "./dist/cjs/expressions/index.d.ts",
        "default": "./dist/cjs/expressions/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "expressions": ["./dist/cjs/expressions/index.d.ts"]
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
