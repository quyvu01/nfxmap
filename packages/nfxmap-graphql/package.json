{
  "name": "nfxmap-graphql",
  "version": "0.1.0",
  "description": "GraphQL integration of nfxmap (FxMap for Node.js): resolves the mapped fields of a graphql-js schema, batched per query level",
  "license": "Apache-2.0",
  "author": "quyvu01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quyvu01/nfxmap.git",
    "directory": "packages/nfxmap-graphql"
  },
  "keywords": [
    "fxmap",
    "nfxmap",
    "graphql",
    "dataloader",
    "mapping",
    "distributed",
    "microservices"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dataloader": "^2.2.3"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0",
    "nfxmap": "^0.1.0"
  },
  "devDependencies": {
    "@graphql-tools/schema": "^10.1.5",
    "@types/node": "^22.10.0",
    "graphql": "^16.14.2",
    "nfxmap": "*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
