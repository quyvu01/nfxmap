{
  "name": "nfxmap-grpc",
  "version": "0.1.0",
  "description": "gRPC transport for nfxmap (FxMap for Node.js): the FxMapTransportService of FxMap, client and server",
  "license": "Apache-2.0",
  "author": "quyvu01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quyvu01/nfxmap.git",
    "directory": "packages/nfxmap-grpc"
  },
  "keywords": [
    "fxmap",
    "nfxmap",
    "grpc",
    "mapping",
    "distributed",
    "microservices"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grpc/proto-loader": "^0.8.0"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "nfxmap": "^0.1.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@types/node": "^22.10.0",
    "nfxmap": "*",
    "protobufjs": "^7.6.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
