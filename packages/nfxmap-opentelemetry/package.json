{
  "name": "nfxmap-opentelemetry",
  "version": "0.1.0",
  "description": "OpenTelemetry for nfxmap (FxMap for Node.js): the spans, metrics and W3C trace context of FxMap",
  "license": "Apache-2.0",
  "author": "quyvu01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quyvu01/nfxmap.git",
    "directory": "packages/nfxmap-opentelemetry"
  },
  "homepage": "https://github.com/quyvu01/nfxmap/tree/main/packages/nfxmap-opentelemetry#readme",
  "bugs": {
    "url": "https://github.com/quyvu01/nfxmap/issues"
  },
  "keywords": [
    "fxmap",
    "nfxmap",
    "opentelemetry",
    "tracing",
    "metrics",
    "distributed",
    "microservices"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0",
    "nfxmap": "^0.1.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^22.10.0",
    "nfxmap": "*",
    "nfxmap-grpc": "*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
