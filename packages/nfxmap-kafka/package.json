{
  "name": "nfxmap-kafka",
  "version": "0.1.0",
  "description": "Kafka transport for nfxmap (FxMap for Node.js): requests and replies on the topics FxMap uses",
  "license": "Apache-2.0",
  "author": "quyvu01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quyvu01/nfxmap.git",
    "directory": "packages/nfxmap-kafka"
  },
  "homepage": "https://github.com/quyvu01/nfxmap/tree/main/packages/nfxmap-kafka#readme",
  "bugs": {
    "url": "https://github.com/quyvu01/nfxmap/issues"
  },
  "keywords": [
    "fxmap",
    "nfxmap",
    "kafka",
    "mapping",
    "distributed",
    "microservices"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "kafkajs": "^2.0.0",
    "nfxmap": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "kafkajs": "^2.2.4",
    "nfxmap": "*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
